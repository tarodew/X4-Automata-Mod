<?xml version='1.0' encoding='utf-8'?>
<mdscript name="Nyto_Automata_Territory">
  <cues>
    <!-- External policy supplies a sector. This layer never attacks or changes ownership. -->
    <cue name="Request" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <run_actions ref="Authorize">
          <param name="Sector" value="event.param"/>
        </run_actions>
      </actions>
    </cue>
    <library name="Authorize" purpose="run_actions">
      <params>
        <param name="Sector"/>
      </params>
      <actions>
        <set_value name="$S" exact="global.$nyto_automata"/>
        <do_if value="not $Sector or not $Sector.isclass.sector">
          <return value="false"/>
        </do_if>
        <do_if value="$Sector.owner != faction.ownerless and $Sector.owner != faction.yorha and $Sector.owner != faction.player">
          <run_actions ref="md.Nyto_Automata_Core.Log">
            <param name="Text" value="'Construction refused in foreign-owned sector: ' + $Sector.knownname"/>
          </run_actions>
          <return value="false"/>
        </do_if>
        <do_if value="$Sector.owner == faction.player and not $S.$settings.$allow_sponsor_building">
          <return value="false"/>
        </do_if>
        <set_value name="$Key" exact="$Sector.macro.id"/>
        <do_if value="$S.$sector_index.{$Key}?">
          <set_value name="$S.$diagnostics.$duplicates_prevented" operation="add" exact="1"/>
          <return value="true"/>
        </do_if>
        <set_value name="$R" exact="table[$key = $Key, $sector = $Sector, $sponsor = ($Sector.owner == faction.player), $created = player.age, $status = 'authorized', $admin = null, $cluster = null, $is_arsenal = false, $front_gate = false, $security_ready = false]"/>
        <set_value name="$S.$sector_index.{$Key}" exact="$R"/>
        <append_to_list name="$S.$sectors" exact="$R"/>
        <!-- Exactly fourteen projects: central admin replaces defence #1, never station #15. -->
        <do_all exact="$S.$project_template.count" counter="$i">
          <set_value name="$Kind" exact="$S.$project_template.{$i}"/>
          <do_if value="$R.$sponsor and $Kind == 'admin'">
            <set_value name="$Kind" exact="'defence'"/>
          </do_if>
          <run_actions ref="NewProject">
            <param name="Record" value="$R"/>
            <param name="Kind" value="$Kind"/>
            <param name="Ordinal" value="$i"/>
          </run_actions>
        </do_all>
        <run_actions ref="md.Nyto_Automata_Core.Log">
          <param name="Text" value="'Authorized concurrent administration/defence and infrastructure projects in ' + $Sector.knownname + '. Nothing is claimed until actual ownership changes.'"/>
        </run_actions>
        <return value="true"/>
      </actions>
    </library>
    <library name="NewProject" purpose="run_actions">
      <params>
        <param name="Record"/>
        <param name="Kind"/>
        <param name="Ordinal"/>
        <param name="Station" default="null"/>
      </params>
      <actions>
        <set_value name="$S" exact="global.$nyto_automata"/>
        <set_value name="$Key" exact="'%1:%2'.[$Record.$key, $Ordinal]"/>
        <do_if value="$S.$project_index.{$Key}?">
          <return value="$S.$project_index.{$Key}"/>
        </do_if>
        <set_value name="$P" exact="table[$key = $Key, $kind = $Kind, $sector_record = $Record, $sector = $Record.$sector, $ordinal = $Ordinal, $station = $Station, $expansion = ($Station != null), $phase = 'authorized', $builder = null, $created = player.age, $order = null, $sequence = null, $build = null, $expected = table[], $last_issue = 0s, $blocker = '', $generation_requested = false]"/>
        <set_value name="$S.$project_index.{$Key}" exact="$P"/>
        <append_to_list name="$S.$projects" exact="$P"/>
        <return value="$P"/>
      </actions>
    </library>
    <cue name="Tick" instantiate="true">
      <conditions>
        <event_cue_signalled cue="md.Nyto_Automata_State.Pulse"/>
      </conditions>
      <actions>
        <run_actions ref="TickActions"/>
      </actions>
    </cue>
    <library name="Step" purpose="run_actions">
      <params>
        <param name="P"/>
      </params>
      <actions>
        <set_value name="$S" exact="global.$nyto_automata"/>
        <do_if value="$P.$phase == 'operational' or $P.$phase == 'lost' or $P.$phase == 'generation_failed'">
          <return/>
        </do_if>
        <do_if value="not $P.$sector.exists">
          <set_value name="$P.$blocker" exact="'SECTOR_LOST'"/>
          <return/>
        </do_if>
        <do_if value="$P.$sector.owner != faction.ownerless and $P.$sector.owner != faction.yorha and not ($P.$sector_record.$sponsor and $P.$sector.owner == faction.player)">
          <set_value name="$P.$blocker" exact="'FOREIGN_OWNER_DO_NOT_CONTINUE'"/>
          <return/>
        </do_if>
        <do_if value="$P.$kind == 'admin' and $P.$sector.owner == faction.player">
          <set_value name="$P.$blocker" exact="'PLAYER_TERRITORY_NO_ADMIN'"/>
          <return/>
        </do_if>
        <do_if value="$P.$phase == 'authorized'">
          <do_if value="not $S.$blueprints.{$P.$kind}?">
            <set_value name="$P.$blocker" exact="'MISSING_BLUEPRINT'"/>
            <return/>
          </do_if>
          <do_if value="$P.$expansion and (not $P.$station.isoperational or $P.$station.owner != faction.yorha)">
            <set_value name="$P.$blocker" exact="'HQ_BASE_NOT_OPERATIONAL'"/>
            <return/>
          </do_if>
          <do_if value="not $P.$expansion">
            <!-- Latch before creating the invisible shell: a failed call cannot spawn duplicates. -->
            <set_value name="$P.$phase" exact="'creating_shell'"/>
            <set_value name="$Position" exact="$S.$project_positions.{$P.$ordinal}"/>
            <create_station name="$Station" macro="macro.station_ter_tradestation_base_01_macro" sector="$P.$sector" owner="faction.yorha" rawname="'YoRHa ' + $P.$kind">
              <safepos x="$Position.$x" y="0m" z="$Position.$z" includeplotbox="true"/>
            </create_station>
            <do_if value="not $Station">
              <set_value name="$P.$phase" exact="'generation_failed'"/>
              <set_value name="$P.$blocker" exact="'SHELL_CREATION_FAILED_NO_DUPLICATE_RETRY'"/>
              <return/>
            </do_if>
            <set_value name="$P.$station" exact="$Station"/>
          </do_if>
          <set_value name="$P.$station.$nyto_automata_project" exact="$P.$key"/>
          <set_build_plot object="$P.$station" x="40km" y="30km" z="40km"/>
          <set_value name="$P.$macros" exact="$S.$blueprints.{$P.$kind}"/>
          <set_value name="$P.$expected" exact="table[]"/>
          <do_all exact="$P.$macros.count" counter="$m">
            <set_value name="$Macro" exact="$P.$macros.{$m}"/>
            <do_if value="not $P.$expected.{$Macro}?">
              <set_value name="$Count" exact="0"/>
              <do_if value="$P.$expansion">
                <find_object_component name="$Existing" object="$P.$station" macro="$Macro" multiple="true"/>
                <do_all exact="$Existing.count" counter="$e">
                  <do_if value="$Existing.{$e}.isoperational">
                    <set_value name="$Count" operation="add" exact="1"/>
                  </do_if>
                </do_all>
              </do_if>
              <set_value name="$P.$expected.{$Macro}" exact="$Count"/>
            </do_if>
            <set_value name="$P.$expected.{$Macro}" operation="add" exact="1"/>
          </do_all>
          <set_value name="$P.$phase" exact="'generating_sequence'"/>
          <set_value name="$P.$generation_requested" exact="true"/>
          <set_value name="$P.$last_issue" exact="player.age"/>
          <create_construction_sequence station="$P.$station" macros="$P.$macros" connectors="$S.$connectors" base="if $P.$expansion then $P.$station.constructionsequence else null" timeout="2s" failsafe="true"/>
          <return/>
        </do_if>
        <do_if value="$P.$phase == 'generating_sequence'">
          <do_if value="player.age gt $P.$last_issue + 5min">
            <set_value name="$P.$blocker" exact="'SEQUENCE_CALLBACK_PENDING_NO_DUPLICATE_RETRY'"/>
          </do_if>
          <return/>
        </do_if>
        <do_if value="not @$P.$station.exists">
          <set_value name="$P.$phase" exact="'lost'"/>
          <set_value name="$P.$blocker" exact="'STATION_DESTROYED'"/>
          <run_actions ref="ReleaseBuilder">
            <param name="P" value="$P"/>
          </run_actions>
          <return/>
        </do_if>
        <do_if value="$P.$station.owner != faction.yorha">
          <set_value name="$P.$blocker" exact="'STATION_OWNER_CHANGED'"/>
          <return/>
        </do_if>
        <do_if value="$P.$phase == 'queued' or $P.$phase == 'building'">
          <run_actions ref="Complete" result="$Done">
            <param name="P" value="$P"/>
          </run_actions>
          <do_if value="$Done">
            <set_value name="$P.$phase" exact="'operational'"/>
            <set_value name="$P.$blocker" exact="''"/>
            <set_value name="$P.$completed" exact="player.age"/>
            <signal_objects object="$P.$station" param="'init station'"/>
            <run_actions ref="ReleaseBuilder">
              <param name="P" value="$P"/>
            </run_actions>
            <do_if value="$P.$kind == 'admin'">
              <set_value name="$P.$sector_record.$admin" exact="$P.$station"/>
              <set_value name="$P.$sector_record.$status" exact="if $P.$sector.owner == faction.yorha then 'claimed' else 'admin_operational_claim_pending'"/>
            </do_if>
            <do_if value="$P.$kind == 'hq_extension' and @$P.$cluster">
              <set_value name="$P.$cluster.$hq" exact="$P.$station"/>
              <set_value name="$P.$cluster.$promotion" exact="'operational'"/>
            </do_if>
            <run_actions ref="md.Nyto_Automata_Core.Log">
              <param name="Text" value="'Station project operational: ' + $P.$key + ' (' + $P.$kind + ')'"/>
            </run_actions>
            <return/>
          </do_if>
          <do_if value="@$P.$builder.exists and $P.$builder.owner == faction.yorha">
            <do_if value="@$P.$station.buildingmodule.constructionvessel == $P.$builder">
              <set_value name="$P.$phase" exact="'building'"/>
            </do_if>
            <do_if value="player.age gt $P.$last_issue + 10min">
              <set_value name="$P.$last_issue" exact="player.age"/>
              <do_if value="not @$P.$order.exists">
                <create_order object="$P.$builder" id="'DeployToStation'" name="$P.$order">
                  <param name="station" value="$P.$station"/>
                  <param name="abandonbuildtime" value="6h"/>
                </create_order>
              </do_if>
            </do_if>
            <set_value name="$P.$blocker" exact="'WAITING_FOR_RESOURCES_OR_NATIVE_CONSTRUCTION'"/>
            <return/>
          </do_if>
          <set_value name="$P.$builder" exact="null"/>
          <find_ship name="$Builders" space="player.galaxy" owner="faction.yorha" macro="macro.ship_ter_xl_builder_01_a_macro" multiple="true"/>
          <set_value name="$Closest" exact="null"/>
          <set_value name="$Distance" exact="9999"/>
          <do_all exact="$Builders.count" counter="$b">
            <set_value name="$B" exact="$Builders.{$b}"/>
            <do_if value="$B.isoperational and not @$B.$nyto_automata_project">
              <set_value name="$D" exact="$B.gatedistance.{$P.$sector}"/>
              <do_if value="$D ge 0 and $D lt $Distance">
                <set_value name="$Distance" exact="$D"/>
                <set_value name="$Closest" exact="$B"/>
              </do_if>
            </do_if>
          </do_all>
          <do_if value="$Closest">
            <set_value name="$Closest.$nyto_automata_project" exact="$P.$key"/>
            <set_value name="$P.$builder" exact="$Closest"/>
            <set_value name="$P.$last_issue" exact="player.age"/>
            <create_order object="$Closest" id="'DeployToStation'" name="$P.$order">
              <param name="station" value="$P.$station"/>
              <param name="abandonbuildtime" value="6h"/>
            </create_order>
            <set_value name="$P.$blocker" exact="'BUILDER_DISPATCHED'"/>
          </do_if>
          <do_else>
            <set_value name="$P.$blocker" exact="'WAITING_FOR_REAL_BUILDER'"/>
          </do_else>
        </do_if>
      </actions>
    </library>
    <cue name="SequenceReady" instantiate="true">
      <conditions>
        <event_object_construction_sequence_created/>
        <check_value value="global.$nyto_automata? and @event.object.$nyto_automata_project"/>
      </conditions>
      <actions>
        <run_actions ref="SequenceReadyActions">
          <param name="EventParam2" value="event.param2"/>
          <param name="EventParam" value="event.param"/>
          <param name="EventObject" value="event.object"/>
        </run_actions>
      </actions>
    </cue>
    <library name="Complete" purpose="run_actions">
      <params>
        <param name="P"/>
      </params>
      <actions>
        <do_if value="not $P.$station.isoperational or $P.$station.owner != faction.yorha">
          <return value="false"/>
        </do_if>
        <set_value name="$Checked" exact="[]"/>
        <do_all exact="$P.$macros.count" counter="$m">
          <set_value name="$Macro" exact="$P.$macros.{$m}"/>
          <do_if value="not $Checked.indexof.{$Macro}">
            <append_to_list name="$Checked" exact="$Macro"/>
            <find_object_component name="$Modules" object="$P.$station" macro="$Macro" multiple="true"/>
            <set_value name="$Count" exact="0"/>
            <do_all exact="$Modules.count" counter="$i">
              <do_if value="$Modules.{$i}.isoperational">
                <set_value name="$Count" operation="add" exact="1"/>
              </do_if>
            </do_all>
            <do_if value="$Count lt $P.$expected.{$Macro}">
              <return value="false"/>
            </do_if>
          </do_if>
        </do_all>
        <return value="true"/>
      </actions>
    </library>
    <library name="ReleaseBuilder" purpose="run_actions">
      <params>
        <param name="P"/>
      </params>
      <actions>
        <do_if value="@$P.$builder.exists and @$P.$builder.$nyto_automata_project == $P.$key">
          <set_value name="$P.$builder.$nyto_automata_project" exact="null"/>
        </do_if>
        <set_value name="$P.$builder" exact="null"/>
      </actions>
    </library>
    <library name="TickActions" purpose="run_actions">
      <params/>
      <actions>
        <set_value name="$S" exact="global.$nyto_automata"/>
        <do_if value="not $S.$settings.$enabled or not $S.$settings.$construction">
          <return/>
        </do_if>
        <!-- Bounded scheduler, not a limit on projects or market visibility. Cursor visits all. -->
        <do_all exact="[4, $S.$projects.count].min" counter="$n">
          <set_value name="$S.$cursor_project" operation="add" exact="1"/>
          <do_if value="$S.$cursor_project gt $S.$projects.count">
            <set_value name="$S.$cursor_project" exact="1"/>
          </do_if>
          <run_actions ref="Step">
            <param name="P" value="$S.$projects.{$S.$cursor_project}"/>
          </run_actions>
        </do_all>
      </actions>
    </library>
    <library name="SequenceReadyActions" purpose="run_actions">
      <params>
        <param name="EventParam2"/>
        <param name="EventParam"/>
        <param name="EventObject"/>
      </params>
      <actions>
        <set_value name="$S" exact="global.$nyto_automata"/>
        <set_value name="$Key" exact="$EventObject.$nyto_automata_project"/>
        <do_if value="not $S.$project_index.{$Key}?">
          <return/>
        </do_if>
        <set_value name="$P" exact="$S.$project_index.{$Key}"/>
        <do_if value="$P.$phase != 'generating_sequence' or $P.$station != $EventObject">
          <return/>
        </do_if>
        <do_if value="not $EventParam2 or not $EventParam">
          <set_value name="$P.$phase" exact="'generation_failed'"/>
          <set_value name="$P.$blocker" exact="'NATIVE_SEQUENCE_FAILED'"/>
          <return/>
        </do_if>
        <do_if value="$EventObject.owner != faction.yorha">
          <set_value name="$P.$phase" exact="'generation_failed'"/>
          <set_value name="$P.$blocker" exact="'OWNER_CHANGED_DURING_GENERATION'"/>
          <return/>
        </do_if>
        <set_value name="$P.$sequence" exact="$EventParam"/>
        <generate_loadout sequence="$P.$sequence" faction="faction.terran" level="0.8" result="$Loadouts"/>
        <do_all exact="$Loadouts.count" counter="$l">
          <apply_loadout sequence="$P.$sequence" index="$l" loadout="$Loadouts.{$l}"/>
        </do_all>
        <!-- Commit latch precedes native queue insertion. No resources are added here. -->
        <set_value name="$P.$phase" exact="'queue_submission'"/>
        <add_build_to_expand_station object="$P.$station.buildstorage" buildobject="$P.$station" constructionplan="$P.$sequence" result="$P.$build"/>
        <do_if value="$P.$build">
          <set_value name="$P.$phase" exact="'queued'"/>
          <set_value name="$P.$blocker" exact="'WAITING_FOR_REAL_BUILDER'"/>
        </do_if>
        <do_else>
          <set_value name="$P.$blocker" exact="'QUEUE_SUBMISSION_UNCONFIRMED_NO_DUPLICATE_RETRY'"/>
        </do_else>
      </actions>
    </library>
  </cues>
</mdscript>
